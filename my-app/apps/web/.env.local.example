# ============================================================
# Butler — 环境变量模板
# 复制本文件为 .env.local 后填入真实值，.env.local 已被 .gitignore 忽略
# ============================================================

# Recommended: run ops/lms-sync/lms_sync.py setup to generate local settings.
# 原生 Ollama 连接。模型名需与 ollama list 一致；setup 可自动发现。
DEEPSEEK_API_KEY=ollama
OLLAMA_SERVER_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_SERVER_MODEL=your-installed-model
# Optional second endpoint / 可选第二台主机
# OLLAMA_WINDOWS_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_WINDOWS_MODEL=your-installed-model
LMS_CONTENT_AI_ENABLED=true

# ============================================================
# OCR 多模态（可选，用于扫描件 PDF + 图片课件识别）
# 申请：https://console.mistral.ai/ → API Keys
# 价格：$0.001/页（1000 页 $1，业内最便宜专业 OCR）
# 未填则上传扫描件/图片会报错；只用文字型 PDF 不需要
# ============================================================
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# OCR provider 选择：mistral（默认） / deepseek-vl（占位） / tesseract（占位）
# 后两个尚未实现接入，保留 mistral 即可
OCR_PROVIDER=mistral
