# Optional server configuration. No .env file is needed for first-run AI setup.
# Copy to .env.local only when needed; never commit real keys.
# Select Local/DeepSeek and enter the DeepSeek key in AI setup.
# DeepSeek keys use Windows DPAPI and do not belong in this template.

# School content access still uses the confirmed school/profile policy.
LMS_CONTENT_AI_ENABLED=true

# Optional explicit legacy local service. Uncomment only for an existing service.
# OLLAMA_SERVER_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_SERVER_MODEL=your-installed-model
# OLLAMA_WINDOWS_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_WINDOWS_MODEL=your-installed-model

# Optional separate cloud OCR. Review current pricing on the official Mistral site.
# OCR also needs explicit opt-in in AI setup before selected files are sent.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
OCR_PROVIDER=mistral
# The deepseek-vl and tesseract adapters are not implemented.

# Optional absolute model store. If omitted, derived from this OS account.
# BUTLER_MODELS_DIR=<absolute path to your model folder>
# Source-only connector: existing Python with Playwright. Portable packages include ButlerSync.exe.
# LMS_PYTHON=<absolute path to your existing Python executable>
