# ============================================================
# Butler — 仓库根级忽略规则
# ============================================================

# 依赖
node_modules/
.pnp
.pnp.js

# Next.js 构建产物
.next/
out/

# 环境变量（包含 API key，绝不能提交）
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 编辑器
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Turborepo
.turbo/

# TypeScript 增量编译
*.tsbuildinfo

# Local Python/SQLite smoke-test artifacts
__pycache__/
*.py[cod]
.venv/
my-app/ops/lms-sync/.private/
my-app/ops/lms-sync/config.local.json
my-app/ops/lms-sync/courses/
*.sqlite
*.sqlite-wal
*.sqlite-shm
release/
.tmp-queue.sqlite*

# Private runtime files in any clone or worker location
.private/
config.local.json
courses/
.env.*
!.env.local.example
*.sqlite*
